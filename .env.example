# ==============================================================================
# VARIABLES DE ENTORNO - VUELA DATA API & WORKERS
# Según VuelaData lista maestra.md
# ==============================================================================

# ── 1. Base de Datos Transaccional (PostgreSQL / Amazon RDS) ─────────────────
# En docker-compose usa 'postgres:5432', desde tu máquina local usa 'localhost:5432'
DATABASE_URL=postgresql+psycopg://postgres:CAMBIAR_PASSWORD@postgres:5432/vueladata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD
POSTGRES_DB=vueladata

# ── 2. RabbitMQ Message Broker ────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rabbit_admin
RABBITMQ_PASS=CAMBIAR_PASSWORD

# Colas según arquitectura
QUEUE_RDS=q.rds_writer
QUEUE_LAKE=q.lake_writer
PREFETCH_COUNT=100

# ── 3. Amazon S3 / Datalake Bronze (Worker Lake) ──────────────────────────────
AWS_REGION=us-east-1
S3_BUCKET_BRONZE=vueladata-datalake-bronze
LAKE_FLUSH_EVERY_N=50
LAKE_FLUSH_EVERY_SECONDS=60
# En entorno local se activa fallback para guardar en disco sin requerir AWS S3
LOCAL_LAKE_FALLBACK=true

# ── 4. Notificaciones por correo (Worker Notificaciones, Gmail SMTP) ─────────
# SMTP_CLAVE es una "contraseña de aplicación" de Google (16 letras), NO la contraseña de la cuenta.
# Se crea en https://myaccount.google.com/apppasswords (requiere verificación en dos pasos activa).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=tu_cuenta@gmail.com
SMTP_CLAVE=TU_CONTRASENA_DE_APLICACION
SMTP_REMITENTE=tu_cuenta@gmail.com
# Modo pruebas: si tiene un correo, TODOS los correos se envían ahí (no a los pasajeros del seed).
# Déjalo vacío solo cuando los pasajeros tengan correos reales.
EMAIL_DESTINO_PRUEBAS=tu_cuenta@gmail.com

# ── 5. Reglas de notificación (Worker RDS) ────────────────────────────────────
# Desde cuántos minutos de retraso se avisa al pasajero por correo.
UMBRAL_RETRASO_NOTIFICACION_MIN=120
# Código del estado "cancelado" en la tabla estado_vuelo (debe coincidir con el seed).
CODIGO_ESTADO_CANCELADO=CANCELADO
